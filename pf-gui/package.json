{
  "name": "power-forensics-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop workbench for power-forensics (presentation only; forensic truth lives in Rust).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "sidecar": "node scripts/build-sidecar.mjs",
    "check-version": "node scripts/check-version.mjs",
    "release:check": "node scripts/check-version.mjs --release"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "lucide-react": "0.469.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-virtuoso": "4.18.7",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}

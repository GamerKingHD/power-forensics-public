# Normalize line endings in the repository; check out native on Windows.
* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.mjs     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.jsonl   text eol=lf

# Windows scripts and generated files.
*.ps1     text eol=crlf

# Binary assets.
*.ico     binary
*.png     binary
*.exe     binary
*.pfx     binary
*.zip     binary
